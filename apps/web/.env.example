# apps/web environment template (Milestone 19).
# NAMES ONLY — never put real values in this file. Copy to `.env` (gitignored)
# and populate locally.
#
# Public vs server-only is enforced by src/env.js (@t3-oss/env-nextjs):
#   - client block: ONLY NEXT_PUBLIC_* variables reach the browser bundle.
#   - server block: server-only values; never browser-exposed.
# Modal credentials are server-only and have no NEXT_PUBLIC_ form.
#
# When adding variables, update the schema in "/src/env.js" accordingly.

# Client (browser-visible) — the single analyze-endpoint base URL.
NEXT_PUBLIC_ANALYZE_SINGLE_VARIANT_BASE_URL=

# Server-only examples (never NEXT_PUBLIC_):
# SERVERVAR=
