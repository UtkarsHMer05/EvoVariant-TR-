# EvoVariant-TR root environment template (Milestone 19).
# NAMES ONLY — never put real values in this file. Copy to `.env` (gitignored)
# and populate locally. Real secrets belong in your secret manager / Modal
# tokens, never in the repository.
#
# See docs/security/SECRETS_AND_COST_POLICY.md for the full policy.

# --- Cost control -----------------------------------------------------------
# Required (with --run-modal) before any Modal/paid-compute test or run:
# EVOVARIANT_TR_PAID_COMPUTE_ACK=

# --- Modal (server-only; never NEXT_PUBLIC_, never in the browser bundle) ---
# Modal auth lives in `modal token set` / ~/.modal.toml, NOT in this file.
# MODAL_ENVIRONMENT=
# EVOVARIANT_TR_MODAL_APP_NAME=
# EVOVARIANT_TR_GPU_TYPE=

# --- Data acquisition (public archives; no auth expected) -------------------
# EVOVARIANT_TR_DATA_ROOT=
# EVOVARIANT_TR_CLINVAR_FTP_BASE=
