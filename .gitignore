# macOS
.DS_Store
.AppleDouble
.LSOverride

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary files
*.tmp
*.swp
*.swo
*.swn

# Python build/runtime caches (global)
__pycache__/
*.pyc
*.pyo
*.pyd
src/evovariant_tr.egg-info/

# Python virtual environments (global)
.venv/
.venv-*/
venv/

# Editor directories and files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace

# Python coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Frontend (apps/web - Next.js, moved from evo2-frontend at M18)
apps/web/node_modules/
apps/web/.next/
apps/web/out/
apps/web/.env*.local
apps/web/*.tsbuildinfo
apps/web/next-env.d.ts

# Backend (evo2-backend - Python/Modal)
evo2-backend/evo2/
evo2-backend/__pycache__/
evo2-backend/*.pyc
evo2-backend/*.pyo
evo2-backend/*.pyd
evo2-backend/.venv/
evo2-backend/venv/
evo2-backend/env/
evo2-backend/*.env
evo2-backend/.env
evo2-backend/brca1_analysis_plot.png

# Data directories (M21: no raw data tracked)
# Raw public archives are downloaded at runtime and never committed.
data/raw/
# Derived datasets (computed, reproducible — regenerate via documented commands).
data/derived/
# Reference genomes (large, downloaded separately).
data/reference/
# Model caches (downloaded at runtime).
data/model_cache/
# Experiment runs (regenerated; only registry manifest + small summaries tracked).
research/runs/*
!research/runs/.gitkeep
research/results/
research/figures/
research/tables/

# Python mypy cache
.mypy_cache/

# Python pytest cache
.pytest_cache/

# Python ruff cache
.ruff_cache/
