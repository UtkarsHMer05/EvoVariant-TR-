{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evovariant-tr.local/schemas/cost_ledger.schema.json",
  "title": "EvoVariant-TR compute cost ledger entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "timestamp", "workload", "backend", "gpu_type", "gpu_count", "estimated_seconds", "measured_seconds", "estimated_usd", "measured_usd", "cache_hit", "approval_artifact", "status", "notes"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "workload": { "type": "string", "minLength": 1 },
    "backend": { "enum": ["local", "modal", "unavailable"] },
    "gpu_type": { "type": ["string", "null"] },
    "gpu_count": { "type": "integer", "minimum": 0 },
    "estimated_seconds": { "type": ["number", "null"], "minimum": 0 },
    "measured_seconds": { "type": ["number", "null"], "minimum": 0 },
    "estimated_usd": { "type": ["number", "null"], "minimum": 0 },
    "measured_usd": { "type": ["number", "null"], "minimum": 0 },
    "cache_hit": { "type": "boolean" },
    "approval_artifact": { "type": ["string", "null"] },
    "status": { "enum": ["PLANNED", "RUNNING", "COMPLETED", "FAILED", "DEFERRED"] },
    "notes": { "type": "string" }
  }
}
