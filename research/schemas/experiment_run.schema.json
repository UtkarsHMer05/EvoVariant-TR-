{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evovariant-tr.local/schemas/experiment_run.schema.json",
  "title": "EvoVariant-TR experiment run record",
  "description": "One immutable, append-only run record. Every scientific run must be identifiable and reproducible from this metadata alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "title",
    "evidence_stage",
    "status",
    "protocol_hash",
    "git_commit",
    "git_dirty",
    "data_manifests",
    "reference_checksum",
    "model_identity",
    "scorer_config",
    "comparator_versions",
    "seed",
    "hardware",
    "command",
    "created_at",
    "updated_at",
    "parent_run_id",
    "output_paths",
    "output_hashes",
    "experiment_family",
    "started_at",
    "completed_at",
    "dataset_manifest_hash",
    "split_manifest_hash",
    "model_name",
    "checkpoint",
    "model_revision",
    "model_source",
    "license_record",
    "preprocessing_version",
    "feature_version",
    "config",
    "GPU",
    "runtime_seconds",
    "estimated_cost_usd",
    "measured_cost_usd",
    "metrics",
    "artifact_paths",
    "failure_reason",
    "notes"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9]{8}T[0-9]{6}Z_[0-9a-f]{8}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "evidence_stage": {
      "enum": [
        "SYNTHETIC_TEST",
        "LEGACY_BASELINE",
        "ENGINEERING_PILOT",
        "PRELIMINARY",
        "FINAL"
      ]
    },
    "status": {
      "enum": ["REGISTERED", "RUNNING", "COMPLETED", "FAILED", "ABORTED"]
    },
    "protocol_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "git_commit": { "type": ["string", "null"] },
    "git_dirty": { "type": "boolean" },
    "data_manifests": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "reference_checksum": { "type": ["string", "null"] },
    "model_identity": { "type": ["string", "null"] },
    "scorer_config": { "type": "object" },
    "comparator_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "seed": { "type": ["integer", "null"] },
    "hardware": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "command": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "parent_run_id": { "type": ["string", "null"] },
    "output_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "output_hashes": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "experiment_family": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "minLength": 1 },
    "completed_at": { "type": ["string", "null"] },
    "dataset_manifest_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "split_manifest_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_name": { "type": ["string", "null"] },
    "checkpoint": { "type": ["string", "null"] },
    "model_revision": { "type": ["string", "null"] },
    "model_source": { "type": ["string", "null"] },
    "license_record": { "type": "object" },
    "preprocessing_version": { "type": ["string", "null"] },
    "feature_version": { "type": ["string", "null"] },
    "config": { "type": "object" },
    "GPU": { "type": ["string", "null"] },
    "runtime_seconds": { "type": ["number", "null"], "minimum": 0 },
    "estimated_cost_usd": { "type": ["number", "null"], "minimum": 0 },
    "measured_cost_usd": { "type": ["number", "null"], "minimum": 0 },
    "metrics": { "type": "object" },
    "artifact_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "failure_reason": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] }
  }
}
